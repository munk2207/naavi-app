#!/bin/sh
# Refuses a push while staging and production have separated beyond the
# recorded baseline.
#
# Why here, and not only in test:auto: binding the drift check to test:auto still
# left a person deciding to run test:auto. That is a ritual, not a gate. Pushing
# is not optional — code that is not pushed does not exist for anyone else — so
# this is the last point at which drift can be caught without anyone choosing to
# look.
#
# Wael's Phase 6 decision, 2026-08-20: "The drift check must become an enforced
# automatic gate, not a command someone must remember to run."
#
# Fails closed. If STAGING_DB_URL is missing from tests/.env, or staging cannot
# be reached, the push is refused rather than waved through. A gate that skips
# itself when it cannot check is not a gate — and "knowledge recorded with
# nothing enforcing it" is the exact failure T4 was opened to fix.
#
# When a difference is DELIBERATE — work on staging not yet promoted, which is
# most of them — record it instead of reverting it:
#     npm run drift:check -- --write-baseline
#
# Enable once per clone:  git config core.hooksPath .githooks

echo "[pre-push] checking the priority list cap..."

# Wael's rule, 2026-08-22: the priority list holds at most 5 items, and adding a
# sixth requires deprioritising one first. "This will force us in cleaning and
# closing items."
#
# Why it is a gate. The list it protects replaced a priority queue that was
# correct the day it was written and never regenerated — by the time it was
# archived it held nine closed items and an entry for a platform that had already
# shipped. The same session found an architecture reference four months stale, a
# parity audit nobody updated, and a work item cited eight times in the shared
# prompt and tracked in no list at all. Every one was knowledge recorded
# correctly with nothing forcing it to stay true.
#
# It counts rows. It cannot tell whether they are the RIGHT five — that is
# judgement, and a counter must never be mistaken for one.
if ! node scripts/priority-cap-check.js; then
  echo ""
  echo "[pre-push] PUSH REFUSED — the priority list is over its cap."
  echo ""
  echo "  Move an item back to the general list before adding another."
  echo "  Deciding what stops being important IS the rule, not paperwork around it."
  echo ""
  exit 1
fi

echo "[pre-push] checking for items written about but not in the list..."

# The priority cap above counts what IS in the table. It cannot see what is
# MISSING from it — and on 2026-08-23 that gap surfaced four times in one
# session. T3 was ranked Tier 1 and referenced by the Architecture Reference
# twice while appearing in no table at all. B4z was cited EIGHT times inside the
# shared Claude prompt as the authority for RULE 23 and tracked nowhere. S1 —
# a P0 security item — and B10x — ranked P1 above everything else — had no row
# in either holding-list file, before or after they closed.
#
# An item becomes real the moment someone writes a paragraph about it. Nothing
# checked that a thing being written about also had an entry.
#
# Scanning every bare mention produced 216 false positives (closed items living
# in the closed archive, plus partial matches). Requiring the deliberate
# [[wiki-link]] form AND the item-ID shape took that to 2 — both real. A check
# that cries wolf gets switched off, which is worse than no check.
if ! node scripts/orphan-item-check.js; then
  echo ""
  echo "[pre-push] PUSH REFUSED — an item is written about but has no row."
  echo ""
  echo "  Give it a row in the holding list, or if it is deliberately untracked:"
  echo "    node scripts/orphan-item-check.js --write-baseline"
  echo ""
  exit 1
fi

echo "[pre-push] checking staging/production parity..."

if ! npm run --silent drift:check; then
  echo ""
  echo "[pre-push] PUSH REFUSED — staging and production have separated."
  echo ""
  echo "  If the difference is intentional, record it and push again:"
  echo "    npm run drift:check -- --write-baseline"
  echo ""
  exit 1
fi

echo "[pre-push] checking code against the database schema..."

# Does deployed code reference columns that do not exist? The drift check above
# compares the two DATABASES to each other; nothing compared either database to
# the CODE. On 2026-08-21 a manual sweep for exactly that found three live
# defects in one sitting — one already losing memory corrections for eight days,
# one reachable by a spoken sentence, one armed to stop every alert on the next
# deploy. All three had sat in the same list looking unremarkable.
#
# PostgREST fails the WHOLE statement when one column is missing, and most call
# sites read that as 'no data' rather than as an error, so the failure is total
# AND silent. That is the worst combination to leave uncovered.
#
# Fails on NEW findings only. The inherited backlog is recorded in
# docs/schema_code_known_findings.json — real defects, not dismissals.
if ! npm run --silent schema:check; then
  echo ""
  echo "[pre-push] PUSH REFUSED — code references a column that does not exist."
  echo ""
  echo "  This fails silently at runtime, not loudly. Fix it, or if the"
  echo "  reference is deliberate and understood, record it:"
  echo "    node scripts/schema-code-check.js --write-baseline"
  echo ""
  exit 1
fi

echo "[pre-push] checking voice Edge Function parity..."

# T12. The two gates above compare the two DATABASES to each other, and the
# code to the database. Neither compares the deployed EDGE FUNCTIONS between
# the two Supabase projects — the Architecture Reference recorded that as a
# known weakness (0c, 0d) and it went unaddressed for three months.
#
# It matters because the Edge Functions live in THIS repo while the voice
# server lives in another one. Promoting voice merges staging -> main over
# there and moves none of them, so every voice promotion has delivered half a
# change and left the rest behind.
#
# This is the fast tripwire. It reads the manifest the deploy wrapper writes,
# so it costs seconds and can run on every push — but anyone using the raw
# Supabase CLI bypasses it. It CANNOT demonstrate equilibrium and must never
# be cited as having done so. Only `npm run parity:verify`, which downloads
# and diffs the real deployed source from both projects, can:
#
#     npm run parity:verify
#
# It also asserts OUTBOUND_ALLOWLIST is unset on production. Once the outbound
# guard is deployed to both projects, that secret's absence is the ONLY thing
# keeping production sends unfiltered. Set it there by accident and alerts stop
# arriving silently.
if ! npm run --silent parity:check; then
  echo ""
  echo "[pre-push] PUSH REFUSED — voice Edge Function parity."
  echo ""
  echo "  If the difference is deliberate, record it WITH A REASON:"
  echo "    npm run parity:verify -- --write-baseline"
  echo ""
  exit 1
fi

exit 0